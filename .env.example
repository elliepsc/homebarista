# ==========================================================================
# HomeBarista — configuration (copy to .env ; .env is gitignored)
# Loaded via python-dotenv in engine/llm_client.py, and by docker-compose.
# ==========================================================================

# --------------------------------------------------------------------------
# LLM — ALL model settings live here (single gateway: engine/llm_client.py)
# Used by: orchestration/agent.py, engine/symptom_extractor.py,
#          pipeline/pipeline.py, ingestion/content_classifier.py,
#          evals/run_rag_eval.py, evals/run_retrieval_eval.py
#
# LLM_PROVIDER: groq (default — free tier) | anthropic | openai
# LLM_MODEL:    leave empty for the provider default
#               (groq → llama-3.3-70b-versatile, anthropic → claude-haiku-4-5,
#                openai → gpt-4o-mini)
# Key: only the key of the active provider is needed. LLM_API_KEY (generic)
#      overrides the provider-specific variable if set.
# Groq free key: https://console.groq.com/keys
# --------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=
GROQ_API_KEY=
# LLM_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_BASE_URL=   # optional: point groq/openai provider at any OpenAI-compatible
#                 # endpoint (Ollama, OpenRouter, vLLM...) — leave empty otherwise

# --------------------------------------------------------------------------
# App mode — pipeline/pipeline.py, app/streamlit_app.py
# true  = demo: deterministic engine + mock coaching, zero API calls/keys
# false = live: agentic LLM loop (needs the LLM key above)
# --------------------------------------------------------------------------
DEMO_MODE=true

# --------------------------------------------------------------------------
# Ingestion (offline only — building the knowledge base, not the app)
# YOUTUBE_API_KEY: YouTube Data API v3 key, used by ingestion/youtube_client.py
# via ingestion/run_ingestion.py. NOT needed to run the app or the demo.
# --------------------------------------------------------------------------
YOUTUBE_API_KEY=

# --------------------------------------------------------------------------
# Vector store — pipeline/vector_store.py (ChromaDB persistence)
# --------------------------------------------------------------------------
CHROMA_PERSIST_DIR=data/chroma_db

# --------------------------------------------------------------------------
# Streamlit live-mode lock — app/streamlit_app.py
# (on Streamlit Cloud, set it in .streamlit/secrets.toml instead)
# --------------------------------------------------------------------------
LIVE_PASSWORD=
