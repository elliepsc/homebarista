# HomeBarista environment template
# Copy this file to .env for local development. Keep real secrets out of git.

# App mode
# true: deterministic demo mode, no API calls required
# false: live LLM mode, requires an LLM key below
DEMO_MODE=true

# LLM
# Supported providers: groq, anthropic, openai
# Leave LLM_MODEL empty to use the provider default from engine/llm_client.py.
LLM_PROVIDER=groq
LLM_MODEL=

# Use either LLM_API_KEY or the provider-specific key.
# LLM_API_KEY takes priority if both are set.
# LLM_API_KEY=
GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional OpenAI-compatible endpoint override for groq/openai providers.
# LLM_BASE_URL=

# Local vector store
CHROMA_PERSIST_DIR=data/chroma_db

# Offline ingestion
# Required only when running ingestion against the YouTube Data API.
YOUTUBE_API_KEY=

# Optional ingestion pacing and quota limits.
# TRANSCRIPT_DELAY_MIN_S=20
# TRANSCRIPT_DELAY_MAX_S=60
# MAX_VIDEOS_PER_RUN=12
# YOUTUBE_QUOTA_BUDGET=8000

# Streamlit live-mode password
# On Streamlit Cloud, set this in .streamlit/secrets.toml instead.
LIVE_PASSWORD=

# Streamlit Cloud snapshot restore
# Optional. Set all three required values to download a private Chroma snapshot
# from a draft GitHub release at app startup.
SNAPSHOT_GITHUB_TOKEN=
SNAPSHOT_GITHUB_REPO=
SNAPSHOT_GITHUB_RELEASE_ID=
# SNAPSHOT_GITHUB_ASSET=chroma_snapshot.zip
