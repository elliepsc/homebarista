# ==========================================================================
# HomeBarista — Streamlit Cloud secrets template
# Copy the content below into the app's "Secrets" box on share.streamlit.io
# (Settings → Secrets). NOT loaded locally — local dev uses .env instead
# (see .env.example). This file is committed only as documentation; the
# real .streamlit/secrets.toml is gitignored and never used on Cloud.
# ==========================================================================

# Password that unlocks Live mode for visitors who don't paste their own
# API key (app/streamlit_app.py). Pick something you can share selectively
# (e.g. with reviewers) — anyone without it can still try Live mode with
# their own Groq/Anthropic/OpenAI key, session-only, never stored.
LIVE_PASSWORD = "change-me"

# Same LLM config as .env.example — LLM_API_KEY (generic) wins over any
# provider-specific key below, so it's the only one you need to set here.
# NOTE: if you ever switch LLM_PROVIDER, update/clear LLM_API_KEY too —
# it always takes priority and would otherwise get sent to the wrong
# provider (see engine/llm_client.py get_api_key()).
# Keep DEMO_MODE=true so the app is free-to-browse by default; Live mode
# is opt-in per visitor (password or BYO key).
LLM_PROVIDER = "groq"
LLM_MODEL = ""
LLM_API_KEY = "your-groq-key"
# GROQ_API_KEY = ""
# ANTHROPIC_API_KEY = ""
# OPENAI_API_KEY = ""
DEMO_MODE = "true"

CHROMA_PERSIST_DIR = "data/chroma_db"
